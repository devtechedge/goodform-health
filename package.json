{
  "name": "goodform-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "GOODFORM - single-brand holistic supplements store for India with FSSAI publishing gates, integer-paise INR pricing, and routine builder.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devtechedge/goodform-health.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate && tsx scripts/gen-ddl.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "packshots:generate": "tsx scripts/generate-packshots.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@fontsource/dm-mono": "^5.2.5",
    "@fontsource/dm-serif-display": "^5.2.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.560.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "razorpay": "^2.9.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^17.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
