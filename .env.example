# Application environment: development | test | demo | production
# Note: Demo accounts (@goodform.demo) are disabled when APP_ENV=production.
APP_ENV=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection strings (Neon pooled for app, direct/unpooled for migrations)
# Leave blank locally to run against embedded PGLite with seeded demo data.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=

# 32+ character secret used for HMAC cookie signing and CSRF tokens
SESSION_SECRET=replace-with-at-least-32-random-bytes-in-production

# Merchant GST dispatch state code (2-letter Indian state code, default Maharashtra MH)
MERCHANT_DISPATCH_STATE=MH

# Razorpay India (optional - when omitted, checkout runs in honest non-charging demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe INR adapter (optional secondary payment adapter)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (optional - when omitted, emails write to the database email_outbox sink)
RESEND_API_KEY=
EMAIL_FROM="GOODFORM Care <care@goodform.example>"
